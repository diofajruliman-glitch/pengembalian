# Isi pada .env.local di komputer, dan Project Settings > Environment Variables di Vercel
# Publishable / anon key adalah client key. Keamanan ditentukan oleh login + RLS Supabase.
VITE_SUPABASE_URL=https://PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxx
# Optional: set only after reviewing/applying recovery-sdm-status-activation.sql.
# VITE_RECOVERY_SDM_MODE=production-sdm
# Optional: activate only after recovery-followup-activation.sql is reviewed/applied.
# VITE_RECOVERY_FOLLOWUP_MODE=production-followup
